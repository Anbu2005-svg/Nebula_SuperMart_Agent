TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# LLM Provider Configuration — Local Ollama API
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-super

# Dual API key pool for rate-limit failover
LLM_API_KEY_1=your_ollama_api_key_here
LLM_API_KEY_2=

# Database Configuration
DB_PATH=supermarket.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/supermarket_db

# Security & Authentication
REQUIRE_AUTH=true
