# ── Telegram Bot ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── LLM Provider (Ollama Cloud) ──────────────────────────────────────
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=nemotron-3-super

# Dual API key pool for rate-limit failover
LLM_API_KEY_1=your_ollama_api_key_1_here
LLM_API_KEY_2=your_ollama_api_key_2_here

# ── Prisma Cloud PostgreSQL Database ─────────────────────────────────
# Get this from https://console.prisma.io → Your Project → Connection String
DATABASE_URL=postgres://USERNAME:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require
